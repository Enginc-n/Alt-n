//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════
// Kripto Ajan PRO – Likidasyon Fitili  (Pine Script v6)
// Ayar gerektirmez: test edilmiş değerler koda gömülüdür ve sağ üst panelde otomatik gösterilir.
//
// Önerilen grafik: 1 saat · BTC / ETH / SOL USDT perpetual (ör. BINANCE:BTCUSDT.P, OKX:ETHUSDT.P).
// Gerçek veri testi (OKX USDT perpetual, BTC+ETH+SOL, %0,05 giriş + %0,05 çıkış komisyon, 1H):
//   ilk %60: 47 işlem +6,6R · son %40 (görülmemiş dönem): 43 işlem +20,2R
//
// Sinyal: hacmi 20 mumluk ortalamanın ≥2,5 katı, boyu ≥1,8 ATR olan mum son 20 mumun dibini (tepesini)
// süpürür, aralığının ≥%50'si alt (üst) fitil kalır ve mumun üst (alt) %40'ında kapanırsa ters yöne girilir.
// Stop: fitil ucunun 0,25 ATR ötesi (en az 1 ATR ve en az fiyatın %0,6'sı) · TP1 = 1R (%50 kapat, SL girişe)
// TP2 = 2R (kalanı kapat). Giriş = onaylı sinyal mumunun kapanışı; yönetim bir sonraki mumda başlar;
// aynı mumda SL ve hedef → önce SL; ters sinyal → kapanıştan kapat; aynı anda tek pozisyon. Repaint yok.
// ═══════════════════════════════════════════════════════════════════════════════════════
indicator("Kripto Ajan PRO – Likidasyon Fitili", shorttitle="KriptoAjan", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ───────── GÖMÜLÜ AYARLAR (gerçek veride test edilen değerler) ─────────
ATR_LEN  = 14       // ATR (Wilder)
VOL_LEN  = 20       // hacim ortalaması
REL_MIN  = 2.5      // min göreli hacim (× ortalama)
RNG_MIN  = 1.8      // min mum boyu (× önceki mumun ATR'si)
WICK_MIN = 0.5      // min fitil / mum boyu
POS_MIN  = 0.6      // kapanış, fitilin tersindeki %40'lık bölgede
SWEEP    = 20       // süpürülen önceki mum sayısı
BUF      = 0.25     // stop tamponu (× ATR, fitil ucunun ötesi)
MIN_SL   = 1.0      // min stop (× ATR)
MIN_RISK = 0.006    // min stop mesafesi (fiyatın %0,6'sı; komisyon koruması)
TP1_R    = 1.0      // TP1 (R)
TP2_R    = 2.0      // TP2 (R)
FEE      = 0.0005   // komisyon, tek yön (%0,05)
WARM     = 130      // ısınma (ilk mumlarda sinyal yok)

// ───────── GÖSTERGELER (hepsi global kapsamda: v6'da her mumda hesaplanır) ─────────
atr     = ta.atr(ATR_LEN)
atrPrev = nz(atr[1])
volSma  = ta.sma(nz(volume), VOL_LEN)
prevLo  = ta.lowest(low, SWEEP)[1]
prevHi  = ta.highest(high, SWEEP)[1]
rng     = high - low
rel     = volSma > 0 ? nz(volume) / volSma : 0.0
lw      = rng > 0 ? (math.min(open, close) - low) / rng : 0.0     // alt fitil oranı
uw      = rng > 0 ? (high - math.max(open, close)) / rng : 0.0    // üst fitil oranı
posL    = rng > 0 ? (close - low) / rng : 0.0
posS    = rng > 0 ? (high - close) / rng : 0.0
rngAtr  = atrPrev > 0 ? rng / atrPrev : 0.0

// ───────── SİNYAL ─────────
bool  base  = bar_index >= WARM and rel >= REL_MIN and atr > 0 and atrPrev > 0 and rng >= RNG_MIN * atrPrev
int   dirW  = not base ? 0 : (lw >= WICK_MIN and posL >= POS_MIN) ? 1 : (uw >= WICK_MIN and posS >= POS_MIN) ? -1 : 0
bool  swept = dirW == 1 ? (not na(prevLo) and low < prevLo) : dirW == -1 ? (not na(prevHi) and high > prevHi) : false
bool  sigL  = dirW == 1 and swept
bool  sigS  = dirW == -1 and swept
float tip   = dirW == 1 ? low : high
float slAtr = atr > 0 ? math.max(math.max(MIN_SL, (dirW * (close - tip) + BUF * atr) / atr), MIN_RISK * close / atr) : 0.0

// ───────── POZİSYON DURUMU ─────────
var int   pos      = 0
var float entry    = na
var float sl       = na
var float tp1      = na
var float tp2      = na
var float risk     = na
var bool  tp1Hit   = false
var int   entryBar = 0
var line  lnE  = na
var line  lnS  = na
var line  lnT1 = na
var line  lnT2 = na
var box   bxW  = na
var box   bxL  = na
var int   trades = 0
var int   wins   = 0
var float totR   = 0.0

bool   evLong  = false
bool   evShort = false
bool   evTp1   = false
bool   evClose = false
string aMsg    = ""
string tk      = syminfo.ticker

updDraw(bool fin) =>
    if fin
        line.set_extend(lnE, extend.none)
        line.set_extend(lnS, extend.none)
        line.set_extend(lnT1, extend.none)
        line.set_extend(lnT2, extend.none)
    line.set_x2(lnE, bar_index)
    line.set_x2(lnS, bar_index)
    line.set_x2(lnT1, bar_index)
    line.set_x2(lnT2, bar_index)
    box.set_right(bxW, bar_index)
    box.set_right(bxL, bar_index)

if barstate.isconfirmed
    if pos != 0 and bar_index > entryBar
        int    d0      = pos
        bool   doClose = false
        bool   rev     = false
        float  rRaw    = 0.0
        float  exitPx  = close
        string whyC    = ""
        bool   hitSL   = pos == 1 ? low <= sl : high >= sl
        bool   hitT1   = pos == 1 ? high >= tp1 : low <= tp1
        bool   hitT2   = pos == 1 ? high >= tp2 : low <= tp2
        if not tp1Hit
            if hitSL
                doClose := true
                rRaw    := -1.0
                exitPx  := sl
                whyC    := "Stop"
            else if hitT1
                tp1Hit := true
                evTp1  := true
                sl     := entry
                line.set_y1(lnS, sl)
                line.set_y2(lnS, sl)
                box.set_top(bxL, entry)
                box.set_bottom(bxL, entry)
                if hitT2
                    doClose := true
                    rRaw    := 0.5 * TP1_R + 0.5 * TP2_R
                    exitPx  := tp2
                    whyC    := "TP2"
        else
            if hitSL
                doClose := true
                rRaw    := 0.5 * TP1_R
                exitPx  := sl
                whyC    := "Başabaş stop"
            else if hitT2
                doClose := true
                rRaw    := 0.5 * TP1_R + 0.5 * TP2_R
                exitPx  := tp2
                whyC    := "TP2"
        if not doClose and ((pos == 1 and sigS) or (pos == -1 and sigL))
            float remR = pos * (close - entry) / risk
            rRaw    := tp1Hit ? 0.5 * TP1_R + 0.5 * remR : remR
            exitPx  := close
            doClose := true
            rev     := true
            whyC    := "Ters sinyal"
        string lTxt = ""
        if evTp1
            lTxt := "🎯 TP1 + SL GİRİŞE"
            aMsg := "Kripto Ajan " + tk + ": TP1 alındı (%50 kapat), SL girişe " + str.tostring(entry, format.mintick)
        if doClose
            float  rNet = rRaw - 2.0 * FEE * entry / risk
            string rTxt = (rNet >= 0 ? "+" : "") + str.tostring(rNet, "0.00") + "R"
            evClose := true
            trades  += 1
            wins    += rNet > 0 ? 1 : 0
            totR    += rNet
            lTxt := (lTxt != "" ? lTxt + "\n" : "") + (rev ? "📤 POZİSYONU KAPAT" : "🏁 POZİSYON KAPAT") + "\n" + whyC + " (" + rTxt + ")"
            aMsg := (aMsg != "" ? aMsg + " || " : "") + "Kripto Ajan " + tk + (rev ? ": TERS SİNYAL – POZİSYONU KAPAT" : ": POZİSYON KAPAT – " + whyC) + " | " + str.tostring(exitPx, format.mintick) + " | " + rTxt
            updDraw(true)
            pos    := 0
            tp1Hit := false
        else
            updDraw(false)
        if lTxt != ""
            color lBg = rev ? color.orange : doClose ? color.gray : color.lime
            color lFg = doClose and not rev ? color.white : color.black
            label.new(bar_index, d0 == 1 ? high : low, lTxt, style=d0 == 1 ? label.style_label_down : label.style_label_up, color=color.new(lBg, 10), textcolor=lFg, size=size.small)
    else if pos == 0 and (sigL or sigS) and slAtr * atr > 0
        pos      := sigL ? 1 : -1
        entry    := close
        risk     := slAtr * atr
        sl       := entry - pos * risk
        tp1      := entry + pos * TP1_R * risk
        tp2      := entry + pos * TP2_R * risk
        tp1Hit   := false
        entryBar := bar_index
        evLong   := pos == 1
        evShort  := pos == -1
        lnE  := line.new(bar_index, entry, bar_index + 1, entry, color=color.gray, width=2, extend=extend.right)
        lnS  := line.new(bar_index, sl, bar_index + 1, sl, color=color.red, width=2, extend=extend.right)
        lnT1 := line.new(bar_index, tp1, bar_index + 1, tp1, color=color.rgb(129, 230, 129), width=2, extend=extend.right)
        lnT2 := line.new(bar_index, tp2, bar_index + 1, tp2, color=color.rgb(0, 120, 40), width=2, extend=extend.right)
        bxW  := box.new(bar_index, math.max(entry, tp2), bar_index + 1, math.min(entry, tp2), border_color=color.new(color.green, 100), bgcolor=color.new(color.green, 85))
        bxL  := box.new(bar_index, math.max(entry, sl), bar_index + 1, math.min(entry, sl), border_color=color.new(color.red, 100), bgcolor=color.new(color.red, 85))
        string info = "Giriş: " + str.tostring(entry, format.mintick) + "\nSL: " + str.tostring(sl, format.mintick) + "\nTP1: " + str.tostring(tp1, format.mintick) + "\nTP2: " + str.tostring(tp2, format.mintick) + "\nHacim " + str.tostring(rel, "0.0") + "x · Boy " + str.tostring(rngAtr, "0.0") + " ATR · Fitil %" + str.tostring(100.0 * (pos == 1 ? lw : uw), "0")
        label.new(bar_index, pos == 1 ? low : high, pos == 1 ? "🟢 AL" : "🔴 SAT", style=pos == 1 ? label.style_label_up : label.style_label_down, color=pos == 1 ? color.green : color.red, textcolor=color.white, tooltip=info)
        aMsg := "Kripto Ajan " + tk + (pos == 1 ? ": AL" : ": SAT") + " | " + str.replace_all(info, "\n", " | ")

if aMsg != ""
    alert(aMsg, alert.freq_once_per_bar_close)

alertcondition(evLong, "AL", "Kripto Ajan {{ticker}}: AL ({{close}})")
alertcondition(evShort, "SAT", "Kripto Ajan {{ticker}}: SAT ({{close}})")
alertcondition(evTp1, "TP1 + SL girişe", "Kripto Ajan {{ticker}}: TP1 alındı, SL girişe")
alertcondition(evClose, "Pozisyon kapat", "Kripto Ajan {{ticker}}: POZİSYON KAPAT ({{close}})")

// ───────── PANEL (sağ üst, otomatik) ─────────
var table tP = table.new(position.top_right, 2, 9, border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    color  hdrBg  = pos == 1 ? color.new(color.green, 15) : pos == -1 ? color.new(color.red, 15) : color.new(#2a1a8c, 0)
    string st     = pos == 0 ? "⏳ PUSUDA" : tp1Hit ? "🛡 BE " + (pos == 1 ? "LONG" : "SHORT") : pos == 1 ? "🟢 LONG" : "🔴 SHORT"
    color  cBg    = color.new(#3a3f4b, 10)
    float  remP   = pos != 0 ? pos * (close - entry) / risk : 0.0
    float  liveR  = pos != 0 ? (tp1Hit ? 0.5 * TP1_R + 0.5 * remP : remP) : 0.0
    float  wr     = trades > 0 ? 100.0 * wins / trades : 0.0
    bool   hot    = rel >= REL_MIN and rngAtr >= RNG_MIN
    string tfNote = timeframe.period == "60" ? "1 saat ✓" : timeframe.period + " ⚠ test 1 saatte"
    table.cell(tP, 0, 0, "🤖 KRİPTO AJAN PRO", text_color=color.white, bgcolor=hdrBg, text_size=size.normal)
    table.cell(tP, 1, 0, st, text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.normal)
    table.cell(tP, 0, 1, "Giriş / Güncel SL:", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 1, pos != 0 ? str.tostring(entry, format.mintick) + " / " + str.tostring(sl, format.mintick) : "-", text_color=color.yellow, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 2, "TP1 / TP2:", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 2, pos != 0 ? str.tostring(tp1, format.mintick) + (tp1Hit ? " ✓" : "") + " / " + str.tostring(tp2, format.mintick) : "-", text_color=color.lime, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 3, "Anlık R:", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 3, pos != 0 ? (liveR >= 0 ? "+" : "") + str.tostring(liveR, "0.00") + " R" : "-", text_color=pos == 0 ? color.gray : liveR >= 0 ? color.lime : color.red, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 4, "Son mum (hacim/boy/fitil):", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 4, str.tostring(rel, "0.0") + "x / " + str.tostring(rngAtr, "0.0") + " ATR / %" + str.tostring(100.0 * math.max(lw, uw), "0"), text_color=hot ? color.yellow : color.silver, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 5, "Başarı (Win Rate):", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 5, "%" + str.tostring(wr, "0.0") + " (" + str.tostring(wins) + "W / " + str.tostring(trades - wins) + "L)", text_color=color.orange, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 6, "Net Büyüme (R):", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 6, (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + " R", text_color=totR >= 0 ? color.lime : color.red, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 7, "Ayarlar (gömülü):", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 7, "Hacim≥2.5x · Boy≥1.8ATR · Fitil≥%50 · Süpürme 20", text_color=color.aqua, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 0, 8, "Risk / Zaman:", text_color=color.white, bgcolor=cBg, text_size=size.small)
    table.cell(tP, 1, 8, "TP1 1R · TP2 2R · Kom. %0,05 · " + tfNote, text_color=color.aqua, bgcolor=cBg, text_size=size.small)
